# --- Raw data (~2.7 GB, symlinked from the extracted Kaggle archive) -------------
data/raw/
# Same provenance: a symlink into the Kaggle extract, so it would be dangling on a
# fresh clone. Task 1 recreates it; the directory itself stays via .gitkeep.
references/*.csv
!references/.gitkeep

# Stage outputs — produced by `dvc repro`, not committed. The .gitkeep files keep the
# directories themselves in the tree so stages have somewhere to write after a clone.
data/interim/*
!data/interim/.gitkeep
data/processed/*
# The monitoring batch is generated by scripts/create_monitoring_batch.py and is a DVC
# stage dependency, not source. Keep the directory so the path exists on a fresh clone.
data/monitoring/*
!data/monitoring/.gitkeep
!data/processed/.gitkeep
reports/figures/*
!reports/figures/.gitkeep

# --- Model artifacts --------------------------------------------------------------
*.pkl
*.joblib
models/*
!models/.gitkeep

# Run outputs: deployment metadata, leaderboards, and the batch predictions written by
# scripts/predict.py. Regenerated by a training/scoring run, so they are not source.
artifacts/*
!artifacts/.gitkeep

# --- Experiment tracking / logs ---------------------------------------------------
# MLflow run metadata lives in a local SQLite database and its artifacts in
# mlartifacts/. Both are run history, not source.
mlruns/
mlartifacts/
mlflow.db
mlflow.db-journal
logs/

# --- Python -----------------------------------------------------------------------
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- OS / editor ------------------------------------------------------------------
.DS_Store
.vscode/
.idea/
